module(load="imfile" PollingInterval="2")

input(type="imfile"
      File="/var/log/ocsf/*.json"
      Tag="ocsf-incident:"
      Severity="crit"
      Facility="auth"
      PersistStateInterval="1"
      reopenOnTruncate="on"
      freshStartTail="on")

if $syslogtag == "ocsf-incident:" then {
    action(type="omfwd"
           Target="{{ siem_ip }}"
           Port="514"
           Protocol="tcp"
           Template="RSYSLOG_SyslogProtocol23Format"
           action.resumeRetryCount="-1"
           queue.type="LinkedList"
           queue.size="1000")
}
