          <distro_tag op="=" value="RTT_ACCEPTED"/>
          <distro_arch op="=" value="x86_64"/>
        </and>
      </distroRequires>
      <hostRequires>
        <and>
          <system_type value="Machine"/>
          <memory op=">=" value="8192"/>
          <disk_size op=">=" value="80" units="GB"/>
        </and>
      </hostRequires>
      <repos/>
      <partitions/>
      <task name="/distribution/install"/>
