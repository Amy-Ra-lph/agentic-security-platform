<job>
  <whiteboard>Agentic Security — GitHub Deploy Test (no VPN)</whiteboard>
  <recipeSet>
    <recipe whiteboard="idm-server" role="SERVER">
      <distroRequires>
        <and>
          <distro_family op="=" value="RedHatEnterpriseLinux10"/>
          <distro_tag op="=" value="RTT_ACCEPTED"/>
          <distro_arch op="=" value="x86_64"/>
        </and>
      </distroRequires>
      <hostRequires>
        <and>
          <system_type value="Machine"/>
          <memory op=">=" value="8192"/>
          <disk_size op=">=" value="40" units="GB"/>
        </and>
      </hostRequires>
      <repos/>
      <partitions/>
      <task name="/distribution/install"/>
      <task name="/distribution/reservesys">
        <params>
          <param name="RESERVETIME" value="172800"/>
        </params>
      </task>
    </recipe>
    <recipe whiteboard="agent-runner" role="CLIENT">
